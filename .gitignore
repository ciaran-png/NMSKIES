# NMSkies Telescope Automation - Git Ignore

# =============================================================================
# SENSITIVE DATA - NEVER COMMIT
# =============================================================================
config.py                  # Contains API keys and credentials
*.key
*.pem
secrets/

# =============================================================================
# RUNTIME DATA FILES
# =============================================================================
# Current observation data (regenerated each run)
noradid.txt                # User's actual NORAD ID list
tleplan.txt                # Generated observation schedule
current_norad_id.txt       # Runtime state file

# Cache files
cache.json                 # TLE data cache

# =============================================================================
# LOG FILES
# =============================================================================
*.log
telescope_automation_log.txt
api_interaction_log.txt
access_log.txt
guioperations.log
backup_log.txt
dashboard.log
script.log

# =============================================================================
# GENERATED IMAGES
# =============================================================================
weather.jpg
weather.png
weather.gif
*.fits
image.fits

# =============================================================================
